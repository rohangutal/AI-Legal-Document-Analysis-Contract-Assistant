APP_NAME=AI Legal Document Analysis & Contract Assistant
APP_VERSION=0.1.0
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://assistant:assistant@localhost:5432/assistant
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_ENABLED=true
MAX_AGENT_ITERATIONS=3
MAX_EVIDENCE_CHUNKS=10
AGENT_CONFIDENCE_THRESHOLD=0.70
VERIFICATION_THRESHOLD=0.80
LLM_TIMEOUT_SECONDS=30
TRACING_ENABLED=true
HUMAN_APPROVAL_REQUIRED=false
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=26214400
